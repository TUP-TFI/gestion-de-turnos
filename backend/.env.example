# Variables que necesita el perfil prod (se cargan en Render).
# En local no hacen falta: el perfil dev tiene valores por defecto.
# El .env real nunca se commitea.

SPRING_PROFILES_ACTIVE=prod

# Formato JDBC, no el postgres:// que muestra Neon
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Render lo inyecta automáticamente; solo sirve para correr prod en local
PORT=8080
