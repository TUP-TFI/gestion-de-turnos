# Variables que necesita el perfil prod. El .env real nunca se commitea.
#
# El perfil se activa en el comando, no aca:
#   SPRING_PROFILES_ACTIVE=prod ./mvnw spring-boot:run
#
# Abajo hay dos bloques. Dejar uno activo y comentar el otro.

PORT=8080

# --- Bloque A: base de Neon (produccion) ---
# OJO: Flyway aplica las migraciones sobre los datos reales.
# DB_URL va en formato JDBC, no el postgres:// que muestra Neon.
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=
CORS_ALLOWED_ORIGINS=https://gestion-de-turnos-eight.vercel.app

# --- Bloque B: base local de docker-compose, con el perfil prod ---
# Sirve para probar la configuracion de prod sin tocar Neon.
#DB_URL=jdbc:postgresql://localhost:5433/turnos
#DB_USERNAME=turnos
#DB_PASSWORD=turnos
#CORS_ALLOWED_ORIGINS=http://localhost:5173
